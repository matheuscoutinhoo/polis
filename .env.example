# Polis — variáveis de ambiente. Copie para .env e preencha. Nunca versione valores reais.

# --- Banco de dados (PostgreSQL) ---
# Local: `npm run db:local` sobe um PostgreSQL embutido com estes valores.
# Railway: use a referência ${{Postgres.DATABASE_URL}} do serviço PostgreSQL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/polis"
# Opcional: tamanho do pool de conexões por instância (padrão 10).
DATABASE_POOL_MAX=10
# Somente para os testes de integração (banco separado, é limpo a cada execução).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/polis_test"

# --- URL pública da aplicação ---
# Em produção, o domínio HTTPS do serviço (ex.: https://polis-production.up.railway.app).
# Usada nos links de confirmação e recuperação enviados por e-mail e na proteção de origem.
# /api/health responde 503 enquanto ela ou BETTER_AUTH_SECRET forem inválidas.
BETTER_AUTH_URL="http://localhost:3000"

# --- Autenticação (Better Auth) ---
# Segredo longo e aleatório, com pelo menos 32 caracteres. Para gerar:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Trocar o segredo invalida as sessões.
BETTER_AUTH_SECRET=""
# Limite de tentativas de login/cadastro/recuperação: sempre ativo em produção.
# Use "on" para ativar também em desenvolvimento.
AUTH_RATE_LIMIT=""

# --- E-mail transacional (confirmação de conta e recuperação de senha) ---
# O envio usa SMTP. No Railway, SMTP de saída só funciona no plano Pro; nos planos
# Free, Trial e Hobby a conexão é bloqueada e os e-mails não são enviados.
# Sem SMTP_HOST, em desenvolvimento as mensagens vão para .dev-mail/outbox.jsonl;
# em produção o envio falha (o erro fica no log).
# Remetente: use um endereço que o seu servidor SMTP aceite como remetente.
MAIL_FROM="Polis <nao-responda@seu-dominio.org>"
SMTP_HOST=""
SMTP_PORT=587
# "true" para TLS direto (porta 465); por padrão, inferido pela porta.
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASSWORD=""
# Endereço exibido na política de privacidade para solicitações (opcional).
CONTACT_EMAIL=""
# Somente para testes ponta a ponta com build de produção sem SMTP: grava os
# e-mails na caixa local em vez de falhar. Nunca use em produção real.
# POLIS_ALLOW_DEV_MAIL="true"
# DEV_MAIL_DIR=".dev-mail"

# --- OpenAI (somente no servidor) ---
# Sem chave, as funções de IA ficam indisponíveis com mensagem clara; o restante funciona.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-6.2-sol"
# Opcionais
OPENAI_TIMEOUT_MS=45000
# "low", "medium" ou "high" (somente para modelos com raciocínio configurável)
OPENAI_REASONING_EFFORT=""
AI_MAX_OUTPUT_TOKENS=1200
AI_DRAFT_MAX_OUTPUT_TOKENS=6000
AI_DAILY_QUESTIONS_PER_USER=15
AI_DAILY_GLOBAL_LIMIT=500

# --- Busca automática de acontecimentos ---
# Lê as notícias oficiais da Agência Senado e da Agência Câmara, cria os
# acontecimentos com a IA e publica os que passam nas verificações (os demais
# ficam como rascunho). Sem OPENAI_API_KEY, a busca só lista o que encontrou.
# Agendamento no próprio servidor: ligado em produção, desligado em desenvolvimento.
# "on" liga também em desenvolvimento; "off" desliga (a busca manual continua).
EVENTS_AUTO_FETCH=""
# Horários das buscas (horas cheias, separadas por vírgula) e fuso horário.
EVENTS_FETCH_HOURS="7,19"
EVENTS_FETCH_TIMEZONE="America/Sao_Paulo"
# Publicações por busca (1 a 10) e período das notícias consideradas, em horas.
EVENTS_FETCH_MAX=3
EVENTS_FETCH_WINDOW_HOURS=36
